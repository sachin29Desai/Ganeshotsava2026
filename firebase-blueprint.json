{
  "entities": {
    "Expense": {
      "title": "Expense",
      "description": "Festival expenditure and vendor payments",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "item": { "type": "string" },
        "est": { "type": "number" },
        "adv": { "type": "number" },
        "bal": { "type": "number" },
        "act": { "type": "number" },
        "receiptUrl": { "type": "string" },
        "receiptName": { "type": "string" },
        "receiptType": { "type": "string" },
        "receiptDate": { "type": "string" },
        "notes": { "type": "string" },
        "bills": {
          "type": "array",
          "description": "Attached bills and invoice receipts with comments"
        },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "item"]
    },
    "Contribution": {
      "title": "Contribution",
      "description": "Voluntary patron donations from residents",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "rcptNo": { "type": "string" },
        "name": { "type": "string" },
        "flat": { "type": "string" },
        "amt": { "type": "number" },
        "date": { "type": "string" },
        "pay": { "type": "string" },
        "txn": { "type": "string" },
        "notes": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "rcptNo", "name", "amt"]
    },
    "Sponsor": {
      "title": "Sponsor",
      "description": "Commercial and corporate festival sponsorships",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invNo": { "type": "string" },
        "det": { "type": "string" },
        "est": { "type": "number" },
        "act": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "invNo", "det", "act"]
    },
    "CommercialStall": {
      "title": "CommercialStall",
      "description": "Commercial stall and kiosk vendor bookings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invNo": { "type": "string" },
        "det": { "type": "string" },
        "est": { "type": "number" },
        "act": { "type": "number" },
        "date": { "type": "string" },
        "notes": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "invNo", "det", "act"]
    },
    "SevaBooking": {
      "title": "SevaBooking",
      "description": "Devotional seva and pooja bookings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tokNo": { "type": "string" },
        "seva": { "type": "string" },
        "name": { "type": "string" },
        "flat": { "type": "string" },
        "amt": { "type": "number", "description": "Voluntary donation amount in rupees (optional/non-mandatory)" },
        "qty": { "type": "number", "description": "Quantity or units sponsored by devotee (e.g. 10 kg, 2 bags)" },
        "unit": { "type": "string", "description": "Unit of measurement (e.g. kg, Bags, Liters, Slots)" },
        "date": { "type": "string" },
        "notes": { "type": "string" },
        "status": { "type": "string", "description": "Status: Booked or Confirmed" },
        "phone": { "type": "string" },
        "gothra": { "type": "string" },
        "nakshatra": { "type": "string" },
        "createdBy": { "type": "string" },
        "confirmedBy": { "type": "string" },
        "confirmedAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "tokNo", "seva", "name"]
    },
    "SevaCatalogue": {
      "title": "SevaCatalogue",
      "description": "Pooja, item and devotional seva offerings catalogue",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "amt": { "type": "number", "description": "Suggested voluntary donation in rupees (optional/non-mandatory)" },
        "unit": { "type": "string", "description": "Unit of measurement (e.g. kg, Bags, Liters, Tins, Slots)" },
        "totalRequired": { "type": "number", "description": "Total quantity or units required for the festival" },
        "desc": { "type": "string", "description": "Details or specifications of the seva" }
      },
      "required": ["id", "name"]
    },
    "HundiCollection": {
      "title": "HundiCollection",
      "description": "Hundi, sanctum and aarti collection counts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "det": { "type": "string" },
        "act": { "type": "number" },
        "date": { "type": "string" },
        "countedBy": { "type": "string" },
        "notes": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "det", "act", "date"]
    },
    "AuctionItem": {
      "title": "AuctionItem",
      "description": "Maha Laddu and puja artifact auction bids",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invNo": { "type": "string" },
        "det": { "type": "string" },
        "by": { "type": "string" },
        "act": { "type": "number" },
        "date": { "type": "string" },
        "notes": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "invNo", "det", "by", "act"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Application and event configuration",
      "type": "object",
      "properties": {
        "org": { "type": "string" },
        "location": { "type": "string" },
        "upi": { "type": "string" },
        "payee": { "type": "string" },
        "logo": { "type": "string" },
        "adminHash": { "type": "string" }
      }
    },
    "Counters": {
      "title": "Counters",
      "description": "Sequential numbering counters for receipts and invoices",
      "type": "object",
      "properties": {
        "rc": { "type": "string" },
        "sp": { "type": "string" },
        "cs": { "type": "string" },
        "sv": { "type": "string" },
        "auc": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Collection of all expenditure items"
    },
    "/contributions/{contributionId}": {
      "schema": "Contribution",
      "description": "Collection of voluntary resident donations"
    },
    "/sponsors/{sponsorId}": {
      "schema": "Sponsor",
      "description": "Collection of sponsor invoices"
    },
    "/commercialStalls/{stallId}": {
      "schema": "CommercialStall",
      "description": "Collection of commercial stall vendor bookings"
    },
    "/sevas/{sevaId}": {
      "schema": "SevaBooking",
      "description": "Collection of seva bookings"
    },
    "/sevaCatalogue/{itemId}": {
      "schema": "SevaCatalogue",
      "description": "Catalogue of poojas and suggested amounts"
    },
    "/hundi/{hundiId}": {
      "schema": "HundiCollection",
      "description": "Collection of hundi counts"
    },
    "/auctions/{auctionId}": {
      "schema": "AuctionItem",
      "description": "Collection of auction winning bids"
    },
    "/settings/{configId}": {
      "schema": "Settings",
      "description": "Global event settings"
    },
    "/metadata/{metaId}": {
      "schema": "Counters",
      "description": "Sequential auto-number metadata counters"
    }
  }
}
