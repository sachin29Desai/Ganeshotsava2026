rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "desaisachin95@gmail.com" ||
        request.auth.uid != null
      );
    }

    // 1. User Profiles Collection
    match /user_profiles/{email} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // 2. Event Volunteers Roster Collection
    match /volunteers/{volunteerId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // 3. Community Events Collection
    match /community_events/{eventId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 4. Event Highlights & Photos Collection
    match /event_highlights/{highlightId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 5. Email OTPs for Passwordless Auth
    match /email_otps/{email} {
      allow read, create, update, delete: if true;
    }

    // 6. Voluntary Contributions Collection
    match /contributions/{contributionId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 7. Seva Bookings Collection
    match /sevas/{sevaId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 8. Seva Catalogue Collection
    match /sevaCatalogue/{itemId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 9. Expenditure & Expenses Collection
    match /expenses/{expenseId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 10. Sponsorship Invoices
    match /sponsors/{sponsorId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 11. Commercial Stalls
    match /commercialStalls/{stallId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 12. Hundi Collections
    match /hundi/{hundiId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 13. Settings & App Configuration
    match /settings/{configId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Catch-all safety rule
    match /{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
